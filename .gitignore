# Python
__pycache__/
*.pyc
*.pyo

# Virtualenv (has its own nested .gitignore too, but be explicit)
venv/
env/
.venv/

# SQLite database (runtime data, not source)
*.db
*.db-journal
*.sqlite
*.sqlite3

# Local secrets / env config
.env
.env.*

# OS / editor cruft
.DS_Store
*.swp

# Kiosk browser profile created on the till machine at runtime
deploy/windows/kiosk-profile/

# Runtime output on the till: server startup log, offline wheels. (backups/ is
# left over from the old automated backup script, no longer written to.)
backups/
deploy/windows/server.log
deploy/windows/wheels/
